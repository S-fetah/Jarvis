{
  "name": "@jarvis/voice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Optional downloadable Voice feature module (STT, TTS, VAD, wake-word contracts & runtime)",
  "jarvis": {
    "optionalFeature": true,
    "downloadableAddon": true
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jarvis/protocol": "*",
    "@travisvn/edge-tts": "^1.0.2",
    "kokoro-js": "^1.2.1",
    "onnxruntime-node": "^1.31.1"
  }
}
