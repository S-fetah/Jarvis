{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "../../packages/protocol/src/**/*",
    "../../packages/voice/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@jarvis/protocol": ["../../packages/protocol/src/index.ts"],
      "@jarvis/protocol/*": ["../../packages/protocol/src/*"],
      "@jarvis/voice": ["../../packages/voice/src/index.ts"],
      "@jarvis/voice/*": ["../../packages/voice/src/*"],
      "@shared/*": ["../../packages/protocol/src/*"]
    }
  }
}
