{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    "../../packages/protocol/src/**/*",
    "../../packages/core/src/**/*",
    "../../packages/voice/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "moduleResolution": "bundler",
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@jarvis/protocol": ["../../packages/protocol/src/index.ts"],
      "@jarvis/protocol/*": ["../../packages/protocol/src/*"],
      "@jarvis/core": ["../../packages/core/src/index.ts"],
      "@jarvis/core/*": ["../../packages/core/src/*"],
      "@jarvis/voice": ["../../packages/voice/src/index.ts"],
      "@jarvis/voice/*": ["../../packages/voice/src/*"],
      "@shared/*": ["../../packages/protocol/src/*"]
    }
  }
}
